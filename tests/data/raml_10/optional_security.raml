#%RAML 1.0
title: Secured API
baseUri: http://example.com/api
mediaType: application/json
securitySchemes:
  oauth_2_0:
    description: OAuth 2.0 for authenticating requests.
    type: OAuth 2.0
    describedBy:
      headers:
        Authorization:
          description: Bearer token
          type: string
      responses:
        401:
          description: Bad or expired token.
    settings:
      authorizationUri: https://example.com/oauth/authorize
      accessTokenUri: https://example.com/oauth/token
      authorizationGrants: [ authorization_code, implicit ]
      scopes: [ profile ]
  passthrough:
    description: Pass Through authentication.
    type: Pass Through
    describedBy:
      queryParameters:
        access_token:
          description: Token to authenticate with
          type: string
/users:
  get:
    description: List users; usable anonymously or authenticated
    securedBy: [ null, oauth_2_0 ]
  post:
    description: Create a user
    securedBy: [ oauth_2_0 ]
/public:
  get:
    description: Public endpoint, explicitly unsecured
    securedBy: [ null ]
